<nav>
  <a href="{{ path('app_home') }}" class="nav-logo">EventRes</a>
  <button class="menu-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
  <ul class="nav-links">
    <li><a href="{{ path('app_home') }}" {% if app.request.attributes.get('_route') == 'app_home' %}class="active"{% endif %}>Events</a></li>
    <li id="nav-admin-link" style="display:none"><a href="{{ path('app_admin') }}" {% if app.request.attributes.get('_route') == 'app_admin' %}class="active"{% endif %}>Admin</a></li>
    <li id="nav-settings-li" style="display:none">
      <button onclick="openSettingsModal()" class="btn btn-ghost" style="display:flex; align-items:center; gap:0.5rem;" title="Account Settings">
        ⚙️ Settings
      </button>
    </li>
    <li id="nav-auth-links-container" style="display:contents"><ul id="nav-auth-links" class="nav-links"></ul></li>
  </ul>
</nav>

<div id="settings-modal-backdrop" class="modal-backdrop" onclick="if(event.target===this) document.getElementById('settings-modal-backdrop').classList.remove('open')">
  <div class="modal" style="max-width: 400px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <h3 class="modal-title" style="margin: 0;">Account Settings</h3>
      <button type="button" class="btn btn-ghost" style="padding: 0; min-width: auto; font-size: 1.2rem;" onclick="document.getElementById('settings-modal-backdrop').classList.remove('open')">✕</button>
    </div>
    
    <div class="form-group" style="margin-bottom: 2rem" id="settings-user-group">
      <label>Signed in as</label>
      <div id="settings-user-email" style="padding: 0.65rem 0.9rem; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text-muted); font-size: 0.85rem"></div>
    </div>

    <div class="form-group" style="margin-bottom: 2rem">
      <label>Appearance</label>
      <button onclick="toggleTheme()" class="btn btn-outline btn-full" style="display:flex; justify-content:space-between; align-items:center;">
        <span>Toggle Theme</span>
        <span style="font-size: 1.2rem;">◐</span>
      </button>
    </div>

    <div class="form-group" id="settings-security-group">
      <label>Security</label>
      <button id="settings-add-passkey-btn" class="btn btn-primary btn-full" onclick="doSettingsPasskeyRegister(event)">+ Add Passkey Device</button>
      <div id="settings-passkey-msg" style="margin-top: 0.5rem; font-size: 0.75rem; text-align: center;"></div>
    </div>
  </div>
</div>
